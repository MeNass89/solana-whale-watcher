# Helius
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_SECRET=your_webhook_hmac_secret
HELIUS_WEBHOOK_ID=

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx
