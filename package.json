{
  "name": "solana-whale-watcher",
  "version": "1.0.0",
  "description": "Local Solana whale convergence watcher powered by Helius Enhanced Webhooks.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts scripts/add-wallet.ts scripts/backfill.ts scripts/setup-webhooks.ts --format esm --dts --sourcemap && vite build",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:webhooks": "tsx scripts/setup-webhooks.ts",
    "backfill": "tsx scripts/backfill.ts",
    "add-wallet": "tsx scripts/add-wallet.ts",
    "refresh-pool": "tsx scripts/refresh-pool.ts"
  },
  "keywords": [
    "solana",
    "helius",
    "whale",
    "webhooks"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/static": "9.1.3",
    "@solana/web3.js": "1.98.4",
    "better-sqlite3": "12.9.0",
    "fastify": "5.8.5",
    "helius-sdk": "2.2.2",
    "lru-cache": "11.3.5",
    "node-cron": "4.2.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "preact": "10.29.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.5",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.6.0",
    "@types/node-cron": "3.0.11",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
